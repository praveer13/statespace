------------------------------ MODULE HoldsEnv ------------------------------
(* LAB-5.4: the environment of a hold, read-only and pinned by hash. It declares
   the variables and the environment's actions. Your modules (broken/HoldsUnsafe.tla
   and fixed/Holds.tla) EXTEND it and add the system's actions: Place, Dispatch,
   Handle, Expire and Restart. Replies stay in msgs, so one can be handled twice
   (a duplicate) or late (a delay). You do not edit this file. *)
EXTENDS Naturals, FiniteSets
CONSTANTS MaxTries, CrashesOn
VARIABLES hst, tries, msgs, sent, up, res
envvars == <<hst, tries, msgs, sent, up, res>>

Replies == {"ok", "busy"}

TypeOK == /\ hst \in {"available", "held", "capturing", "captured", "released"}
          /\ tries \in 0..MaxTries
          /\ msgs \subseteq Replies
          /\ sent \in BOOLEAN
          /\ up \in BOOLEAN
          /\ res \in 0..3

\* Environment: the provider replies once a request has been sent.
Reply(r) == /\ sent
            /\ r \notin msgs
            /\ msgs' = msgs \cup {r}
            /\ UNCHANGED <<hst, tries, sent, up, res>>

\* Environment: the worker crashes (only when crash actions are switched on).
Crash == /\ CrashesOn
         /\ up
         /\ up' = FALSE
         /\ UNCHANGED <<hst, tries, msgs, sent, res>>

NeverTwice == res <= 1
=============================================================================
