# H02  The conditional single-statement UPDATE twin of H01: each session runs
# UPDATE acct SET bal = bal - 80 WHERE id = 1 AND bal >= 80. The statement reads
# and writes in one step, so the WHERE clause is re-evaluated on the row version
# a concurrent commit leaves (PostgreSQL 18 manual, section 13.2.1).
# Headline: s1 updates, s2 updates and waits, s1 commits, s2 commits.
#
# Generated by scripts/spikes/W0-S09/make_rows.py from the pattern library that also
# draws the GEN-anomaly-id pool; this file is that pattern at its canonical numbers.
# Levels are separate begin steps (for example s1b_ser); the permutation lines run
# every interleaving that cannot hang isolationtester, level by level, the headline
# interleaving first. The session obs reads the committed state last.
#
# Canonical numbers: balance 100, class contend, amounts [80, 80]

setup
{
  CREATE TABLE acct(id int PRIMARY KEY, bal bigint NOT NULL, team int);
  INSERT INTO acct VALUES (1, 100, 1), (2, 100, 1);
}

teardown
{
  DROP TABLE acct;
}

session s1
step s1b_rc { BEGIN ISOLATION LEVEL READ COMMITTED; }
step s1b_rr { BEGIN ISOLATION LEVEL REPEATABLE READ; }
step s1b_ser { BEGIN ISOLATION LEVEL SERIALIZABLE; }
step s1w { UPDATE acct SET bal = bal - 80 WHERE id = 1 AND bal >= 80 RETURNING old.bal AS old_bal, new.bal AS new_bal; }
step s1c { COMMIT; }

session s2
step s2b_rc { BEGIN ISOLATION LEVEL READ COMMITTED; }
step s2b_rr { BEGIN ISOLATION LEVEL REPEATABLE READ; }
step s2b_ser { BEGIN ISOLATION LEVEL SERIALIZABLE; }
step s2w { UPDATE acct SET bal = bal - 80 WHERE id = 1 AND bal >= 80 RETURNING old.bal AS old_bal, new.bal AS new_bal; }
step s2c { COMMIT; }

session obs
step chk { SELECT id, bal FROM acct ORDER BY id; }

permutation s1b_rc s1w s2b_rc s2w s1c s2c chk
permutation s1b_rc s1w s1c s2b_rc s2w s2c chk
permutation s2b_rc s2w s1b_rc s1w s2c s1c chk
permutation s2b_rc s2w s2c s1b_rc s1w s1c chk
permutation s1b_rr s1w s2b_rr s2w s1c s2c chk
permutation s1b_rr s1w s1c s2b_rr s2w s2c chk
permutation s2b_rr s2w s1b_rr s1w s2c s1c chk
permutation s2b_rr s2w s2c s1b_rr s1w s1c chk
permutation s1b_ser s1w s2b_ser s2w s1c s2c chk
permutation s1b_ser s1w s1c s2b_ser s2w s2c chk
permutation s2b_ser s2w s1b_ser s1w s2c s1c chk
permutation s2b_ser s2w s2c s1b_ser s1w s1c chk
