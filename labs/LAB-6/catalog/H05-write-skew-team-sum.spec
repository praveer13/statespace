# H05  Write skew on existing rows (Adya G2-item). Two accounts of 100 form a team;
# the invariant is that the team total stays at or above 0. Each session reads
# the team total (200), then debits 150 from a different account if the total
# allows it. Neither writes a row the other writes.
# Headline: both read, both write, s1 commits, then s2 commits.
#
# Generated by scripts/spikes/W0-S09/make_rows.py from the pattern library that also
# draws the GEN-anomaly-id pool; this file is that pattern at its canonical numbers.
# Levels are separate begin steps (for example s1b_ser); the permutation lines run
# every interleaving that cannot hang isolationtester, level by level, the headline
# interleaving first. The session obs reads the committed state last.
# What a session read is kept in a temporary table named seen, as the client's memory,
# and its write uses that value.
#
# Canonical numbers: balance 100, class contend, amounts [150, 150]

setup
{
  CREATE TABLE acct(id int PRIMARY KEY, bal bigint NOT NULL, team int);
  INSERT INTO acct VALUES (1, 100, 1), (2, 100, 1);
}

teardown
{
  DROP TABLE acct;
}

session s1
step s1b_rc { BEGIN ISOLATION LEVEL READ COMMITTED; }
step s1b_rr { BEGIN ISOLATION LEVEL REPEATABLE READ; }
step s1b_ser { BEGIN ISOLATION LEVEL SERIALIZABLE; }
step s1r { CREATE TEMP TABLE seen ON COMMIT DROP AS SELECT sum(bal) AS total FROM acct WHERE team = 1; SELECT total FROM seen; }
step s1w { UPDATE acct SET bal = bal - 150 WHERE id = 1 AND (SELECT total FROM seen) - 150 >= 0 RETURNING old.bal AS old_bal, new.bal AS new_bal; }
step s1c { COMMIT; }

session s2
step s2b_rc { BEGIN ISOLATION LEVEL READ COMMITTED; }
step s2b_rr { BEGIN ISOLATION LEVEL REPEATABLE READ; }
step s2b_ser { BEGIN ISOLATION LEVEL SERIALIZABLE; }
step s2r { CREATE TEMP TABLE seen ON COMMIT DROP AS SELECT sum(bal) AS total FROM acct WHERE team = 1; SELECT total FROM seen; }
step s2w { UPDATE acct SET bal = bal - 150 WHERE id = 2 AND (SELECT total FROM seen) - 150 >= 0 RETURNING old.bal AS old_bal, new.bal AS new_bal; }
step s2c { COMMIT; }

session obs
step chk { SELECT id, bal FROM acct ORDER BY id; SELECT sum(bal) AS team_total FROM acct WHERE team = 1; }

permutation s1b_rc s1r s2b_rc s2r s1w s2w s1c s2c chk
