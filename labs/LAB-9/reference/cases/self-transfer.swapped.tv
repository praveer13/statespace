# S9.L2 cell 1: the compiled self-transfer with its two writes swapped, credit first
source transfer 5 a1 a1
output
  ldi      r0 5
  ldi      r1 1
  assertGe r0 r1 nonPositive
  read     r0 a1
  ldi      r1 5
  assertGe r0 r1 insufficient
  ldi      r0 5
  read     r1 a1
  add      r1 r1 r0
  write    a1 r1
  read     r1 a1
  sub      r1 r1 r0
  write    a1 r1
