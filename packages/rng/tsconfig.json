{
  // The sources compile with no DOM, no WebWorker and no Node types, so a package that names window, fetch or
  // indexedDB fails here; packages/purity-lint checks the same rule on the text. Tests compile separately
  // (test/tsconfig.json), because they may use Node's test runner.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.rng.tsbuildinfo"
  },
  "include": ["src"]
}
