{
  // See packages/rng/tsconfig.json: sources compile without DOM or Node types; tests compile separately.
  // `paths` maps the one specifier the vendored fsrs.ts imports from kernelspace's learner types.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.learner.tsbuildinfo",
    "paths": {
      "@/lib/learner/types": ["./src/schedule/kernelspace-types.ts"]
    }
  },
  "include": ["src"]
}
