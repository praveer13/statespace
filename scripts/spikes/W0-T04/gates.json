      "lanes": {
        "fast": { "args_if_env": { "STATESPACE_PRIVACY_TERMS": ["--strict"] } },
        "nightly": { "args_if_env": { "STATESPACE_PRIVACY_TERMS": ["--strict"] } },
        "release": { "args": ["--strict"] }
      },
      "note": "--strict turns the missing hashed term list and the missing second course license into failures: the release lane always uses it, the other lanes once the owner has set the CI secrets"
    },
    { "id": "GATE-schema", "kind": "gate", "script": "scripts/verify-schema.mjs", "built_by": "W0-T02", "lanes": { "fast": {}, "nightly": {}, "release": { "args": ["--strict"] } } },
    { "id": "GATE-lessons", "kind": "gate", "script": "scripts/verify-lessons.mjs", "built_by": "W1-T38", "lanes": { "fast": {}, "nightly": {} } },
    { "id": "GATE-erosions", "kind": "gate", "script": "scripts/verify-erosions.mjs", "built_by": "W2-T42", "lanes": { "fast": {}, "nightly": {} } },
    { "id": "GATE-runs", "kind": "gate", "script": "scripts/verify-runs.mjs", "built_by": "W0-S11", "lanes": { "fast": {}, "nightly": {}, "release": { "args": ["--release"] } }, "note": "--release also fails on forward references (a {{run:}} in a draft whose run is not recorded yet), on inputs that changed since their run and on a stale index. Drafts wait for runs for most of the project (ARCHITECTURE.md section 9.2), so only the release lane uses it; the nightly lane runs the default checks, which fail on registry integrity and on unresolved references in learner copy not labeled draft" },

    { "id": "GATE-replay", "kind": "gate", "script": "scripts/verify-replay.mjs", "built_by": "W2-T03", "lanes": { "nightly": {} } },
    { "id": "GATE-conformance", "kind": "gate", "script": "scripts/verify-conformance.mjs", "built_by": "W1-T42", "lanes": { "nightly": {} } },
    { "id": "GATE-specimens", "kind": "gate", "script": "scripts/verify-specimens.mjs", "built_by": "W1-T42", "lanes": { "nightly": {} } },
    { "id": "GATE-labs", "kind": "gate", "script": "scripts/verify-labs.mjs", "built_by": "W1-T43", "lanes": { "nightly": {}, "monthly": {} }, "note": "the monthly lane runs it on the newest stable Lean, named in STATESPACE_LEAN_TOOLCHAIN" },
    { "id": "GATE-audit", "kind": "gate", "script": "scripts/verify-audit.mjs", "built_by": "W1-T40", "lanes": { "nightly": {} } },
    { "id": "GATE-a11y", "kind": "gate", "script": "scripts/a11y.mjs", "built_by": "W1-T41", "lanes": { "nightly": {} } },

    { "id": "numbers-self-check", "kind": "check", "argv": ["node", "scripts/verify-numbers.mjs", "--self-check"], "needs": "scripts/verify-numbers.mjs", "built_by": "W0-S11", "lanes": { "nightly": {}, "release": {} }, "note": "plants faults in a scratch copy; the gate must fail on each" },
    { "id": "runs-self-check", "kind": "check", "argv": ["node", "scripts/verify-runs.mjs", "--self-check"], "needs": "scripts/verify-runs.mjs", "built_by": "W0-S11", "lanes": { "nightly": {}, "release": {} } },
    { "id": "schema-self-check", "kind": "check", "argv": ["node", "scripts/verify-schema.mjs", "--self-check"], "needs": "scripts/verify-schema.mjs", "built_by": "W0-T02", "lanes": { "nightly": {}, "release": {} } },
    { "id": "privacy-self-test", "kind": "check", "argv": ["node", "scripts/verify-privacy.mjs", "--self-test"], "needs": "scripts/verify-privacy.mjs", "built_by": "W0-T01", "lanes": { "nightly": {}, "release": {} } },
    { "id": "facts-self-check", "kind": "check", "argv": ["node", "scripts/verify-facts.mjs", "--self-check"], "needs": "scripts/verify-facts.mjs", "built_by": "W0-T08", "lanes": { "nightly": {}, "release": {} } },

    { "id": "GATE-release", "kind": "gate", "script": "scripts/verify-release.mjs", "built_by": "W5-T09", "lanes": { "release": { "required": true } }, "note": "the stub: until W5-T09 builds the script, the release lane fails closed" }
  ]
