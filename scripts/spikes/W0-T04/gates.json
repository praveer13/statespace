{
  "format": "lane-manifest/1",
  "description": "The steps of the CI lanes (spine section 11.2, ARCHITECTURE.md section 13). scripts/spikes/W0-T04/lane.mjs reads this file; the workflows in .github/workflows/ call the runner and list no gate. A step whose script does not exist yet is reported as absent, with the task that builds it; it is not skipped silently and not counted as a pass. In a lane where a step is required, an absent script fails the lane (fail closed). A gate task adds its script under scripts/ and, if it needs other arguments in a lane, edits that gate's row here. lane-manifest.test.mjs checks the gate rows against the spine's registry in packages/ids.",
  "lanes": {
    "fast": { "step_timeout_s": 120, "budget_s": 300 },
    "nightly": { "step_timeout_s": 1800 },
    "release": { "step_timeout_s": 1800 },
    "monthly": { "step_timeout_s": 3600 }
  },
  "steps": [
    { "id": "vendor-verify", "kind": "check", "argv": ["npm", "run", "vendor:verify"], "needs": "scripts/vendor-drift.mjs", "built_by": "W0-S12", "lanes": { "fast": {}, "nightly": {}, "release": {} } },
    { "id": "lint-purity", "kind": "check", "argv": ["npm", "run", "lint:purity"], "needs": "packages/purity-lint/check.mjs", "built_by": "W0-S12", "lanes": { "fast": {}, "nightly": {}, "release": {} } },
    { "id": "typecheck", "kind": "check", "argv": ["npm", "run", "typecheck"], "needs": "package.json", "built_by": "W0-S12", "lanes": { "fast": {}, "nightly": {}, "release": {} } },
    { "id": "unit-tests", "kind": "check", "argv": ["npm", "test"], "needs": "package.json", "built_by": "W0-S12", "lanes": { "fast": {}, "nightly": {}, "release": {} } },
    { "id": "build", "kind": "check", "argv": ["npm", "run", "build"], "needs": "package.json", "built_by": "W0-S12", "lanes": { "fast": {}, "nightly": {}, "release": {} } },
    { "id": "lane-tests", "kind": "check", "argv": ["node", "--test", "scripts/spikes/W0-T04/lane.test.mjs", "scripts/spikes/W0-T04/lane-manifest.test.mjs", "scripts/spikes/W0-T04/status-branch.test.mjs", "scripts/spikes/W0-T04/file-issue.test.mjs", "scripts/spikes/W0-T04/emulate-runner.test.mjs", "scripts/spikes/W0-T04/workflows.test.mjs"], "needs": "scripts/spikes/W0-T04/lane.mjs", "built_by": "W0-T04", "lanes": { "fast": {}, "nightly": {} } },

    { "id": "GATE-numbers", "kind": "gate", "script": "scripts/verify-numbers.mjs", "built_by": "W0-S11", "lanes": { "fast": {}, "nightly": {}, "release": { "args": ["--strict"] } } },
    { "id": "GATE-facts", "kind": "gate", "script": "scripts/verify-facts.mjs", "built_by": "W0-T08", "lanes": { "fast": {}, "nightly": {}, "release": {} } },
    { "id": "GATE-calls", "kind": "gate", "script": "scripts/verify-calls.mjs", "built_by": "W1-T05", "lanes": { "fast": {}, "nightly": {} }, "note": "the Lean calls run only in the nightly lane, inside the Bench image; W1-T37 decides how the script tells the two apart" },
    { "id": "GATE-interp", "kind": "gate", "script": "scripts/verify-interp.mjs", "built_by": "W2-T08", "lanes": { "fast": {}, "nightly": {} } },
