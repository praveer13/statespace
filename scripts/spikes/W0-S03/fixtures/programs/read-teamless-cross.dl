// The reference rules plus two derived relations: teamless users (a wildcard under negation) and
// cross-tenant reads (a comparison between two variables, several joins).
.decl tenant_of_user(u: symbol, a: symbol)
.decl tenant_of_team(t: symbol, a: symbol)
.decl member(u: symbol, t: symbol, r: symbol)
.decl owns(t: symbol, d: symbol)
.decl subteam(s: symbol, t: symbol)
.decl share_user(d: symbol, u: symbol)
.decl share_team(d: symbol, t: symbol)
.decl revoked(d: symbol, u: symbol)
.input tenant_of_user
.input tenant_of_team
.input member
.input owns
.input subteam
.input share_user
.input share_team
.input revoked

.decl inteam(u: symbol, t: symbol)
.decl canread(u: symbol, d: symbol)
.decl canedit(u: symbol, d: symbol)
.decl teamless(u: symbol)
.decl cross_read(u: symbol, d: symbol)
.output inteam
.output canread
.output canedit
.output teamless
.output cross_read

inteam(u, t)  :- member(u, t, _).
inteam(u, t)  :- inteam(u, s), subteam(s, t).
canread(u, d) :- inteam(u, t), owns(t, d).
canread(u, d) :- share_user(d, u), !revoked(d, u).
canread(u, d) :- inteam(u, t), share_team(d, t).
canedit(u, d) :- member(u, t, r), owns(t, d), r != "viewer".
teamless(u)   :- tenant_of_user(u, _), !member(u, _, _).
cross_read(u, d) :- canread(u, d), tenant_of_user(u, a), owns(t, d), tenant_of_team(t, b), a != b.
