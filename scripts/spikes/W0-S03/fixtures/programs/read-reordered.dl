// The reference rules in reverse order: a Datalog program means the same in any order.
.decl tenant_of_user(u: symbol, a: symbol)
.decl tenant_of_team(t: symbol, a: symbol)
.decl member(u: symbol, t: symbol, r: symbol)
.decl owns(t: symbol, d: symbol)
.decl subteam(s: symbol, t: symbol)
.decl share_user(d: symbol, u: symbol)
.decl share_team(d: symbol, t: symbol)
.decl revoked(d: symbol, u: symbol)
.input tenant_of_user
.input tenant_of_team
.input member
.input owns
.input subteam
.input share_user
.input share_team
.input revoked

.decl inteam(u: symbol, t: symbol)
.decl canread(u: symbol, d: symbol)
.decl canedit(u: symbol, d: symbol)
.output inteam
.output canread
.output canedit

canedit(u, d) :- member(u, t, r), owns(t, d), r != "viewer".
canread(u, d) :- inteam(u, t), share_team(d, t).       // rule 3: shared with one of the user's teams
canread(u, d) :- share_user(d, u), !revoked(d, u).     // rule 2: shared with the user, not revoked
canread(u, d) :- inteam(u, t), owns(t, d).             // rule 1: a member of the owning team
inteam(u, t)  :- inteam(u, s), subteam(s, t).
inteam(u, t)  :- member(u, t, _).
