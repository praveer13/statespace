// S7.L2's English variant: "editors of the owning team, or anyone it is shared with, unless
// revoked". Constants inside atoms, and a negated premise on the team-share rule too.
.decl tenant_of_user(u: symbol, a: symbol)
.decl tenant_of_team(t: symbol, a: symbol)
.decl member(u: symbol, t: symbol, r: symbol)
.decl owns(t: symbol, d: symbol)
.decl subteam(s: symbol, t: symbol)
.decl share_user(d: symbol, u: symbol)
.decl share_team(d: symbol, t: symbol)
.decl revoked(d: symbol, u: symbol)
.input tenant_of_user
.input tenant_of_team
.input member
.input owns
.input subteam
.input share_user
.input share_team
.input revoked

.decl inteam(u: symbol, t: symbol)
.decl canread(u: symbol, d: symbol)
.decl canedit(u: symbol, d: symbol)
.output inteam
.output canread
.output canedit

inteam(u, t)  :- member(u, t, _).
inteam(u, t)  :- inteam(u, s), subteam(s, t).
canread(u, d) :- member(u, t, "editor"), owns(t, d).
canread(u, d) :- share_user(d, u), !revoked(d, u).
canread(u, d) :- inteam(u, t), share_team(d, t), !revoked(d, u).
canedit(u, d) :- member(u, t, "editor"), owns(t, d).
canedit(u, d) :- member(u, t, "admin"), owns(t, d).
