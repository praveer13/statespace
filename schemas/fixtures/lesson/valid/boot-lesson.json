      "id": "s1",
      "title": "The pull request",
      "minutes": 2,
      "blocks": [
        {
          "type": "prose",
          "md": "An agent opened a pull request. It says: \"Transfer is now guarded. Safe: 200 tests green.\""
        },
        {
          "type": "instrument",
          "ins": "INS-z3",
          "cell": 1,
          "callOnFirstRun": true,
          "recorded": "RUN-z3-starter",
          "call": {
            "prompt": "This query asks for a transfer that leaves both balances negative. What will Z3 return?",
            "options": [
              {
                "id": "A",
                "text": "`sat`",
                "why": "The recipient only gains, so no transfer leaves both balances negative.",
                "mis": "dp:Z5"
              },
              {
                "id": "B",
                "text": "`unsat`",
                "why": "No input meets both constraints, so Z3 has nothing to return but `unsat`."
              },
              {
                "id": "C",
                "text": "`unknown`",
                "why": "Three linear integer constraints are decided outright.",
                "mis": "dp:Z6"
              }
            ],
            "key": "B",
            "keyRun": "RUN-z3-starter",
            "surprise": "yes"
          }
        }
      ]
    },
    {
      "id": "s2",
      "title": "The reveal",
      "minutes": 3,
      "blocks": [
