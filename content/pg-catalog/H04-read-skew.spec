# H04  Read skew (Adya G-single). A reader reads account 1, a transfer of 50 from
# account 1 to account 2 commits, and the reader then reads account 2. Every
# committed state totals 200.
# Headline: rd reads account 1, mv transfers and commits, rd reads account 2.
#
# Generated by scripts/spikes/W0-S09/make_rows.py from the pattern library that also
# draws the GEN-anomaly-id pool; this file is that pattern at its canonical numbers.
# Levels are separate begin steps (for example s1b_ser); the permutation lines run
# every interleaving that cannot hang isolationtester, level by level, the headline
# interleaving first. The session obs reads the committed state last.
#
# Canonical numbers: balance 100, class half, amounts [50]

setup
{
  CREATE TABLE acct(id int PRIMARY KEY, bal bigint NOT NULL, team int);
  INSERT INTO acct VALUES (1, 100, 1), (2, 100, 1);
}

teardown
{
  DROP TABLE acct;
}

session rd
step rdb_rc { BEGIN ISOLATION LEVEL READ COMMITTED; }
step rdb_rr { BEGIN ISOLATION LEVEL REPEATABLE READ; }
step rdb_ser { BEGIN ISOLATION LEVEL SERIALIZABLE; }
step rd1 { SELECT bal FROM acct WHERE id = 1; }
step rd2 { SELECT bal FROM acct WHERE id = 2; }
step rdc { COMMIT; }

session mv
step mvb_rc { BEGIN ISOLATION LEVEL READ COMMITTED; }
step mvb_rr { BEGIN ISOLATION LEVEL REPEATABLE READ; }
step mvb_ser { BEGIN ISOLATION LEVEL SERIALIZABLE; }
step mvt { UPDATE acct SET bal = bal - 50 WHERE id = 1 RETURNING old.bal AS old_bal, new.bal AS new_bal; UPDATE acct SET bal = bal + 50 WHERE id = 2 RETURNING old.bal AS old_bal, new.bal AS new_bal; }
step mvc { COMMIT; }

session obs
step chk { SELECT id, bal FROM acct ORDER BY id; }

permutation rdb_rc rd1 mvb_rc mvt mvc rd2 rdc chk
permutation rdb_rc rd1 rd2 rdc mvb_rc mvt mvc chk
