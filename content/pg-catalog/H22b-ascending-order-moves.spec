# H22b  The same two moves with every statement issued in ascending account order:
# A debits account 1 then credits account 2; B credits account 1 then debits
# account 2. Both sessions take account 1's lock first.
# Headline: A debits 1, B credits 1 and waits, A credits 2 and commits, then B
# debits 2 and commits.
#
# Generated by scripts/spikes/W0-S09/make_rows.py from the pattern library that also
# draws the GEN-anomaly-id pool; this file is that pattern at its canonical numbers.
# Levels are separate begin steps (for example s1b_ser); the permutation lines run
# every interleaving that cannot hang isolationtester, level by level, the headline
# interleaving first. The session obs reads the committed state last.
#
# Canonical numbers: balance 100, class equal, amounts [10, 10]

setup
{
  CREATE TABLE acct(id int PRIMARY KEY, bal bigint NOT NULL, team int);
  INSERT INTO acct VALUES (1, 100, 1), (2, 100, 1);
}

teardown
{
  DROP TABLE acct;
}

session s1
step s1b_rc { BEGIN ISOLATION LEVEL READ COMMITTED; }
step s1b_rr { BEGIN ISOLATION LEVEL REPEATABLE READ; }
step s1b_ser { BEGIN ISOLATION LEVEL SERIALIZABLE; }
step s1d { UPDATE acct SET bal = bal - 10 WHERE id = 1 AND bal >= 10 RETURNING old.bal AS old_bal, new.bal AS new_bal; }
step s1k { UPDATE acct SET bal = bal + 10 WHERE id = 2 RETURNING old.bal AS old_bal, new.bal AS new_bal; }
step s1c { COMMIT; }

session s2
step s2b_rc { BEGIN ISOLATION LEVEL READ COMMITTED; }
step s2b_rr { BEGIN ISOLATION LEVEL REPEATABLE READ; }
step s2b_ser { BEGIN ISOLATION LEVEL SERIALIZABLE; }
step s2k { UPDATE acct SET bal = bal + 10 WHERE id = 1 RETURNING old.bal AS old_bal, new.bal AS new_bal; }
step s2d { UPDATE acct SET bal = bal - 10 WHERE id = 2 AND bal >= 10 RETURNING old.bal AS old_bal, new.bal AS new_bal; }
step s2c { COMMIT; }

session obs
step chk { SELECT id, bal FROM acct ORDER BY id; }

permutation s1b_rc s1d s2b_rc s2k s1k s1c s2d s2c chk
permutation s1b_rc s1d s1k s1c s2b_rc s2k s2d s2c chk
permutation s1b_rc s1d s1k s2b_rc s2k s1c s2d s2c chk
permutation s2b_rc s2k s1b_rc s1d s2d s2c s1k s1c chk
permutation s2b_rc s2k s2d s1b_rc s1d s2c s1k s1c chk
permutation s2b_rc s2k s2d s2c s1b_rc s1d s1k s1c chk
permutation s1b_rr s1d s2b_rr s2k s1k s1c s2d s2c chk
permutation s1b_rr s1d s1k s1c s2b_rr s2k s2d s2c chk
permutation s1b_rr s1d s1k s2b_rr s2k s1c s2d s2c chk
permutation s2b_rr s2k s1b_rr s1d s2d s2c s1k s1c chk
permutation s2b_rr s2k s2d s1b_rr s1d s2c s1k s1c chk
permutation s2b_rr s2k s2d s2c s1b_rr s1d s1k s1c chk
permutation s1b_ser s1d s2b_ser s2k s1k s1c s2d s2c chk
permutation s1b_ser s1d s1k s1c s2b_ser s2k s2d s2c chk
permutation s1b_ser s1d s1k s2b_ser s2k s1c s2d s2c chk
