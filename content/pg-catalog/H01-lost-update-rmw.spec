# H01  Lost update through application read-modify-write (Adya P4). Two sessions
# each debit 80 from a balance of 100: read the balance, then write a constant
# computed from the read (the SET expression does not reference the row, so READ
# COMMITTED's re-check cannot repair it), guarded by the session's own read.
# Headline: both read, s1 writes and commits, then s2 writes and commits.
#
# Generated by scripts/spikes/W0-S09/make_rows.py from the pattern library that also
# draws the GEN-anomaly-id pool; this file is that pattern at its canonical numbers.
# Levels are separate begin steps (for example s1b_ser); the permutation lines run
# every interleaving that cannot hang isolationtester, level by level, the headline
# interleaving first. The session obs reads the committed state last.
# What a session read is kept in a temporary table named seen, as the client's memory,
# and its write uses that value.
#
# Canonical numbers: balance 100, class contend, amounts [80, 80]

setup
{
  CREATE TABLE acct(id int PRIMARY KEY, bal bigint NOT NULL, team int);
  INSERT INTO acct VALUES (1, 100, 1), (2, 100, 1);
}

teardown
{
  DROP TABLE acct;
}

session s1
step s1b_rc { BEGIN ISOLATION LEVEL READ COMMITTED; }
step s1b_rr { BEGIN ISOLATION LEVEL REPEATABLE READ; }
step s1b_ser { BEGIN ISOLATION LEVEL SERIALIZABLE; }
step s1r { CREATE TEMP TABLE seen ON COMMIT DROP AS SELECT bal FROM acct WHERE id = 1; SELECT bal FROM seen; }
step s1w { UPDATE acct SET bal = (SELECT bal FROM seen) - 80 WHERE id = 1 AND (SELECT bal FROM seen) >= 80 RETURNING old.bal AS old_bal, new.bal AS new_bal; }
step s1c { COMMIT; }

session s2
step s2b_rc { BEGIN ISOLATION LEVEL READ COMMITTED; }
step s2b_rr { BEGIN ISOLATION LEVEL REPEATABLE READ; }
step s2b_ser { BEGIN ISOLATION LEVEL SERIALIZABLE; }
step s2r { CREATE TEMP TABLE seen ON COMMIT DROP AS SELECT bal FROM acct WHERE id = 1; SELECT bal FROM seen; }
step s2w { UPDATE acct SET bal = (SELECT bal FROM seen) - 80 WHERE id = 1 AND (SELECT bal FROM seen) >= 80 RETURNING old.bal AS old_bal, new.bal AS new_bal; }
step s2c { COMMIT; }

session obs
step chk { SELECT id, bal FROM acct ORDER BY id; }

permutation s1b_rc s1r s2b_rc s2r s1w s1c s2w s2c chk
permutation s1b_rc s1r s1w s1c s2b_rc s2r s2w s2c chk
