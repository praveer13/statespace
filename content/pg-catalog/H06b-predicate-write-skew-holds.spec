# H06b  Predicate write skew through INSERT (Adya G2), the holds shape. Each
# session reads what is available on account 1 (its balance less the holds
# against it), then inserts a hold of 80 if 80 is available. The two inserts
# write different rows; each read covers what the other inserts.
# Headline: both read, both insert, s1 commits, then s2 commits.
#
# Generated by scripts/spikes/W0-S09/make_rows.py from the pattern library that also
# draws the GEN-anomaly-id pool; this file is that pattern at its canonical numbers.
# Levels are separate begin steps (for example s1b_ser); the permutation lines run
# every interleaving that cannot hang isolationtester, level by level, the headline
# interleaving first. The session obs reads the committed state last.
# What a session read is kept in a temporary table named seen, as the client's memory,
# and its write uses that value.
#
# Canonical numbers: balance 100, class contend, amounts [80, 80]

setup
{
  CREATE TABLE acct(id int PRIMARY KEY, bal bigint NOT NULL, team int);
  INSERT INTO acct VALUES (1, 100, 1), (2, 100, 1);
  CREATE TABLE holds(acct int, amt bigint);
}

teardown
{
  DROP TABLE acct, holds;
}

session s1
step s1b_rc { BEGIN ISOLATION LEVEL READ COMMITTED; }
step s1b_rr { BEGIN ISOLATION LEVEL REPEATABLE READ; }
step s1b_ser { BEGIN ISOLATION LEVEL SERIALIZABLE; }
step s1r { CREATE TEMP TABLE seen ON COMMIT DROP AS SELECT a.bal - coalesce((SELECT sum(h.amt) FROM holds h WHERE h.acct = 1), 0) AS avail FROM acct a WHERE a.id = 1; SELECT avail FROM seen; }
step s1w { INSERT INTO holds SELECT 1, 80 WHERE (SELECT avail FROM seen) >= 80 RETURNING acct, amt; }
step s1c { COMMIT; }

session s2
step s2b_rc { BEGIN ISOLATION LEVEL READ COMMITTED; }
step s2b_rr { BEGIN ISOLATION LEVEL REPEATABLE READ; }
step s2b_ser { BEGIN ISOLATION LEVEL SERIALIZABLE; }
step s2r { CREATE TEMP TABLE seen ON COMMIT DROP AS SELECT a.bal - coalesce((SELECT sum(h.amt) FROM holds h WHERE h.acct = 1), 0) AS avail FROM acct a WHERE a.id = 1; SELECT avail FROM seen; }
step s2w { INSERT INTO holds SELECT 1, 80 WHERE (SELECT avail FROM seen) >= 80 RETURNING acct, amt; }
step s2c { COMMIT; }

session obs
step chk { SELECT (SELECT bal FROM acct WHERE id = 1) AS bal, coalesce(sum(amt), 0) AS held FROM holds; }

permutation s1b_rc s1r s2b_rc s2r s1w s2w s1c s2c chk
permutation s1b_rc s1r s1w s1c s2b_rc s2r s2w s2c chk
