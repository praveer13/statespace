{
  // The tools that run in Node: the Vite config and the Playwright files (whose page.evaluate callbacks run in the
  // browser, so the DOM types are in).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.instruments-node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "e2e"]
}
