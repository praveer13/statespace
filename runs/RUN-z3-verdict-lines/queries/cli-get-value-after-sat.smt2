(set-option :produce-assignments true)
(declare-const a Int)
(declare-const b Int)
(declare-const amount Int)
(assert (>= a 0))
(assert (>= b 0))
(assert (> amount 0))
(assert (< (- a amount) 0))
(check-sat)
(get-info :reason-unknown)
(get-model)
(get-value (a b amount))
(eval (- a amount))
(get-assignment)
(exit)
