@Std.WP.Triple : {Pred : Type u_3} →
  {EPosts : Type u_4} →
    {Prog : Type u_1} →
      {Value : Type u_2} →
        [inst : Std.WP.Assertion Pred] →
          [inst_1 : Std.WP.Assertion EPosts] →
            Prog → [Std.WP.WP Prog Value Pred EPosts] → Pred → (Value → Pred) → EPosts → Prop
@Std.WP.Triple.iff : ∀ {Pred : Type u_3} {EPosts : Type u_4} {Prog : Type u_1} {Value : Type u_2}
  [inst : Std.WP.Assertion Pred] [inst_1 : Std.WP.Assertion EPosts] [inst_2 : Std.WP.WP Prog Value Pred EPosts]
  {x : Prog} {pre : Pred} {post : Value → Pred} {eposts : EPosts},
  ⦃ pre ⦄ x ⦃ post; eposts ⦄ ↔ Order.PartialOrder.rel pre (Std.WP.wp x post eposts)
@Order.PredTrans.mk : {Pred : Type u_1} →
  {EPosts : Type u_2} → {α : Type u_3} → ((α → Pred) → EPosts → Pred) → Order.PredTrans Pred EPosts α
@Order.himp : {α : Type u_1} → [Order.CompleteLattice α] → α → α → α
@Order.meet_apply : ∀ {σ : Type u_1} {β : σ → Type u_2} [inst : (s : σ) → Order.CompleteLattice (β s)]
  (a b : (s : σ) → β s) (s : σ), Order.meet a b s = Order.meet (a s) (b s)
@Order.himp_apply : ∀ {σ : Type u_2} {β : Type u_1} [inst : Order.CompleteLattice β] (a b : σ → β) (s : σ),
  Order.himp a b s = Order.himp (a s) (b s)
Order.meet_prop_eq_and : ∀ (a b : Prop), Order.meet a b = (a ∧ b)
Order.himp_prop_eq_imp : ∀ (a b : Prop), Order.himp a b = (a → b)
