; Transfer's obligation with its fee. Inv: a, b and the fee account f at 0 or above, f at most 100, total 100
(define-fun Inv ((a Int) (b Int) (f Int)) Bool (and (>= a 0) (>= b 0) (>= f 0) (<= f 100) (= (+ a b f) 100)))
(declare-const a Int)
(declare-const b Int)
(declare-const f Int)
(declare-const amt Int)
(declare-const a_p Int)
(declare-const b_p Int)
(declare-const f_p Int)
(assert (Inv a b f))
(assert (and (> amt 0) (<= (+ amt 1) a)))
(assert (and (= a_p (- a amt 1)) (= b_p (+ b amt)) (= f_p (+ f 1))))
(assert (not (and (>= a_p 0) (>= b_p 0) (>= f_p 0) (= (+ a_p b_p f_p) 100))))
(check-sat)
