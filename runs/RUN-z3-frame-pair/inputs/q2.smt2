(declare-fun c () Int)
(declare-fun b () Int)
(declare-fun a () Int)
(declare-fun p_amount () Int)
(declare-fun b_p () Int)
(declare-fun a_p () Int)
(declare-fun c_p () Int)
(assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (and (> p_amount 0) (<= p_amount a)))
(assert (and (= a_p (- a p_amount)) (= b_p (+ b p_amount))))
(assert (= c_p (- c 1)))
(assert (not (and (>= a_p 0) (>= b_p 0) (>= c_p 0))))
(check-sat)
